{
  "name": "bicepflex",
  "version": "0.1.0",
  "type": "module",
  "description": "Azure infrastructure generator using Bicep - CLI and Web UI",
  "keywords": [
    "azure",
    "bicep",
    "infrastructure",
    "iac",
    "azd",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/bicepflex.git"
  },
  "bin": {
    "bicepflex": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "dev:cli": "tsx cli/index.ts",
    "build": "npm run build:web && npm run build:cli",
    "build:web": "tsc && vite build",
    "build:cli": "tsc --project tsconfig.cli.json",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.56.2",
    "ajv": "^8.17.1",
    "axios": "^1.7.7",
    "chalk": "^4.1.2",
    "clsx": "^2.1.1",
    "inquirer": "^8.2.6",
    "lucide-react": "^0.446.0",
    "ora": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.2",
    "yaml": "^2.5.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.10",
    "@types/ora": "^3.1.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.20.6",
    "typescript": "^5.5.3",
    "vite": "^5.4.8"
  }
}
